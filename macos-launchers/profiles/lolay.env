# Profile metadata. NAME here = profile display name; LABEL = short tag used in
# wrapper output ("<NAME> <LABEL>.app" where the leading NAME comes from apps/<app>.env).
# APPS = comma-separated app slugs (must match apps/<slug>.env files); required.
# Claude only: lolay is the Claude Team account (billing + runners beta) used for
# everything outside agerpoint. Cursor/VS Code stay on the personal default.
LABEL=LO
NAME=Lolay
APPS=claude
